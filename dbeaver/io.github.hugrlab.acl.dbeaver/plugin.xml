<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>
<!-- acl-clients spec 007: duckdb-acl as a DBeaver connection type - the Generic provider with our driver
     (bundled), a meta model and a dialect of our own, as DBeaver's own DuckDB plugin is made -->
<plugin>
	<extension point="org.jkiss.dbeaver.dataSourceProvider">
		<dataSourceType id="duckdb_acl" label="duckdb-acl" description="duckdb-acl node"
		                dataSourceInformation="A duckdb-acl node: its Flight SQL door, OAuth sign-in"/>
		<datasource
		        class="org.jkiss.dbeaver.ext.acl.model.AclDataSourceProvider"
		        description="duckdb-acl node (Flight SQL door)"
		        id="duckdb_acl"
		        dataSourceType="duckdb_acl"
		        parent="generic"
		        inheritProviderProperties="true"
		        label="duckdb-acl"
		        dialect="duckdb_acl">
			<!-- The node's tree (Generic's, 26.2, cut to what a duckdb-acl node has). No visibleIf: DBeaver evaluates those
			     with JEXL limited to its own packages, so a condition on our classes is silently false - the node's
			     capabilities are known here. Nested schemas sit under their parent (spec 116 paths); no per-schema
			     Data Types (the types are the system catalog's, the same everywhere); no indexes, sequences, synonyms,
			     triggers or procedures (a table function and a scalar are both functions). -->
			<tree path="duckdb_acl" label="duckdb-acl node" supportsEntityMerge="true">
				<items label="Catalog" path="catalog" property="catalogList" icon="#database" optional="true">
					<items label="Schema" path="schema" property="schemaList" icon="#schema" optional="true">
						<folder type="org.jkiss.dbeaver.ext.generic.model.GenericTable" label="Tables" icon="#folder_table" description="Tables">
							<items label="Table" path="table" property="physicalTables" icon="#table">
								<folder type="org.jkiss.dbeaver.ext.generic.model.GenericTableColumn" label="Columns" icon="#columns" description="Columns">
									<items label="Column" path="attribute" property="attributes" icon="#column"/>
								</folder>
								<folder type="org.jkiss.dbeaver.ext.generic.model.GenericUniqueKey" label="Keys" icon="#constraints" description="Declared keys">
									<items label="Key" path="uniqueKey" property="constraints" icon="#unique-key">
										<items label="Key columns" itemLabel="Column" path="column" property="attributeReferences" navigable="false" inline="true"/>
									</items>
								</folder>
								<folder type="org.jkiss.dbeaver.ext.generic.model.GenericTableForeignKey" label="Foreign Keys" icon="#foreign-keys" description="Declared references to other objects">
									<items label="Foreign Key" path="association" property="associations" icon="#foreign-key">
										<items label="Columns" itemLabel="Column" path="column" property="attributeReferences" navigable="false" inline="true"/>
									</items>
								</folder>
								<folder label="References" icon="#references" description="Declared references from other objects" virtual="true">
									<items label="Reference" path="reference" property="references" icon="#reference" virtual="true">
										<items label="Columns" itemLabel="Column" path="column" property="attributeReferences" navigable="false" inline="true" virtual="true"/>
									</items>
								</folder>
							</items>
						</folder>
						<folder type="org.jkiss.dbeaver.ext.generic.model.GenericView" label="Views" icon="#folder_view" description="Views">
							<items label="View" path="view" property="views" icon="#view">
								<folder type="org.jkiss.dbeaver.ext.generic.model.GenericTableColumn" label="Columns" icon="#columns" description="View columns">
									<items label="Column" path="attribute" property="attributes" icon="#column"/>
								</folder>
							</items>
						</folder>
						<folder label="Functions" icon="#functions" description="Table functions and scalar functions">
							<items label="Functions" itemLabel="Function" path="function" property="functionsOnly" icon="#function">
								<items label="Parameters" itemLabel="Column" path="column" property="parameters" navigable="false"/>
							</items>
						</folder>
						<items label="Schema" path="schema" property="childSchemas" icon="#schema" optional="true" recursive=".."/>
					</items>
				</items>
				<!-- spec 007.3: the Access control branch, read only - shown where the node answered console_info, each folder
				     where the principal reads its platform view or calls its read function (visibleIf on our model's
				     org.jkiss.dbeaver.ext.acl.model classes, which DBeaver's JEXL may call); every node is one statement -->
				<folder label="Access control" icon="#folder" visibleIf="object.accessControl">
					<folder label="Roles" icon="#folder" visibleIf="object.shows('roles')">
						<items label="Role" path="accessRole" property="accessRoles" icon="#user">
							<folder label="Claims" icon="#folder" visibleIf="object.dataSource.shows('role_claims')">
								<items label="Claim" path="roleClaim" property="claims" icon="#info"/>
							</folder>
							<folder label="Catalog grants" icon="#folder" visibleIf="object.dataSource.shows('grants')">
								<items label="Grant" path="catalogGrant" property="catalogGrants" icon="#database"/>
							</folder>
							<folder label="Schema grants" icon="#folder" visibleIf="object.dataSource.shows('schema_grants')">
								<items label="Grant" path="schemaGrant" property="schemaGrants" icon="#schema"/>
							</folder>
							<folder label="Object grants" icon="#folder" visibleIf="object.dataSource.shows('object_grants')">
								<items label="Grant" path="objectGrant" property="objectGrants" icon="#table"/>
							</folder>
							<folder label="Administration" icon="#folder" visibleIf="object.dataSource.shows('admins')">
								<items label="Scope" path="adminScope" property="adminScopes" icon="#info"/>
							</folder>
							<folder label="Resource groups" icon="#folder" visibleIf="object.dataSource.shows('role_resource_groups')">
								<items label="Group" path="roleGroup" property="resourceGroups" icon="#info"/>
							</folder>
							<folder label="Effective rights" icon="#folder" visibleIf="object.dataSource.calls('effective_rights')">
								<items label="Catalog" path="effectiveCatalog" property="effectiveCatalogs" icon="#database">
									<items label="Right" path="effectiveRight" property="rights" icon="#table"/>
								</items>
							</folder>
						</items>
					</folder>
					<folder label="Virtual catalogs" icon="#folder" visibleIf="object.shows('catalogs')">
						<items label="Catalog" path="accessCatalog" property="accessCatalogs" icon="#database">
							<folder label="Relations" icon="#folder_table" visibleIf="object.dataSource.shows('relations')">
								<items label="Relation" path="accessRelation" property="relations" icon="#table">
									<folder label="Columns" icon="#columns" visibleIf="object.dataSource.shows('relation_columns')">
										<items label="Column" path="relationColumn" property="columns" icon="#column"/>
									</folder>
									<folder label="Keys" icon="#constraints" visibleIf="object.dataSource.shows('keys')">
										<items label="Column" path="keyColumn" property="keyColumns" icon="#unique-key"/>
									</folder>
								</items>
							</folder>
							<folder label="Schemas" icon="#schema" visibleIf="object.dataSource.shows('schemas')">
								<items label="Schema" path="virtualSchema" property="virtualSchemas" icon="#schema"/>
							</folder>
							<folder label="Functions" icon="#functions" visibleIf="object.dataSource.shows('functions')">
								<items label="Function" path="functionEntry" property="functionEntries" icon="#function"/>
							</folder>
							<folder label="References" icon="#references" visibleIf="object.dataSource.shows('references')">
								<items label="Reference" path="referenceEntry" property="referenceEntries" icon="#reference"/>
							</folder>
							<folder label="Check" icon="#info" visibleIf="object.dataSource.calls('check_catalog')">
								<items label="Finding" path="finding" property="findings" icon="#info"/>
							</folder>
						</items>
					</folder>
					<folder label="Sources" icon="#folder" visibleIf="object.calls('exposures')">
						<items label="Source" path="accessSource" property="accessSources" icon="#database">
							<folder label="Exposures" icon="#folder">
								<items label="Exposure" path="exposure" property="exposures" icon="#table"/>
							</folder>
						</items>
					</folder>
					<folder label="Identity" icon="#folder" visibleIf="object.shows('issuers') || object.shows('role_mappings')">
						<folder label="Issuers" icon="#folder" visibleIf="object.shows('issuers')">
							<items label="Issuer" path="accessIssuer" property="accessIssuers" icon="#info">
								<folder label="Clients" icon="#folder" visibleIf="object.dataSource.shows('clients')">
									<items label="Client" path="accessClient" property="clients" icon="#info"/>
								</folder>
							</items>
						</folder>
						<folder label="Role mappings" icon="#folder" visibleIf="object.shows('role_mappings')">
							<items label="Mapping" path="roleMapping" property="accessRoleMappings" icon="#info"/>
						</folder>
					</folder>
					<folder label="Function categories" icon="#functions" visibleIf="object.shows('function_categories')">
						<items label="Category" path="functionCategory" property="accessFunctionCategories" icon="#functions">
							<folder label="Members" icon="#folder" visibleIf="object.dataSource.shows('function_category_members')">
								<items label="Function" path="categoryMember" property="members" icon="#function"/>
							</folder>
						</items>
					</folder>
					<folder label="Function grants" icon="#functions" visibleIf="object.shows('function_grants')">
						<items label="Grant" path="functionGrant" property="accessFunctionGrants" icon="#function"/>
					</folder>
					<folder label="Resource groups" icon="#folder" visibleIf="object.shows('resource_groups')">
						<items label="Group" path="resourceGroup" property="accessResourceGroups" icon="#info"/>
					</folder>
					<folder label="Node" icon="#folder" visibleIf="object.shows('sessions') || object.shows('node_load')">
						<folder label="Sessions" icon="#folder" visibleIf="object.shows('sessions')">
							<items label="Session" path="accessSession" property="accessSessions" icon="#info"/>
						</folder>
						<folder label="Load" icon="#folder" visibleIf="object.shows('node_load')">
							<items label="Load" path="accessNodeLoad" property="accessNodeLoad" icon="#info"/>
						</folder>
						<folder label="Doors" icon="#folder" visibleIf="object.shows('node_doors')">
							<items label="Door" path="accessNodeDoor" property="accessNodeDoors" icon="#info"/>
						</folder>
					</folder>
					<folder label="Cluster" icon="#folder" visibleIf="object.shows('cluster_items') || object.shows('drift')">
						<folder label="Profile" icon="#folder" visibleIf="object.shows('cluster_items')">
							<items label="Item" path="accessClusterItem" property="accessClusterItems" icon="#info"/>
						</folder>
						<folder label="Applied here" icon="#folder" visibleIf="object.shows('cluster_effective')">
							<items label="Item" path="accessClusterEffective" property="accessClusterEffective" icon="#info"/>
						</folder>
						<folder label="Drift" icon="#folder" visibleIf="object.shows('drift')">
							<items label="Entry" path="accessDrift" property="accessDrift" icon="#info"/>
						</folder>
					</folder>
				</folder>
			</tree>
			<drivers managable="true">
				<driver
				        id="duckdb_acl_jdbc"
				        label="duckdb-acl"
				        class="io.github.hugrlab.acl.jdbc.AclDriver"
				        sampleURL="jdbc:acl://{host}:{port}"
				        defaultHost="localhost"
				        defaultPort="32800"
				        webURL="https://github.com/hugr-lab/acl-clients"
				        description="duckdb-acl node: Flight SQL door, OAuth sign-in"
				        supportedConfigurationTypes="MANUAL,URL"
				        anonymous="true"
				        categories="sql,analytic">
					<file type="jar" path="bundle:/io.github.hugrlab.acl.jdbc"/>
					<!-- spec 006's drivers.xml: functions listed by getFunctions and getProcedures; the active
					     catalog is the session's USE (duckdb-acl spec 114) -->
					<parameter name="split-procedures-and-functions" value="true"/>
					<parameter name="active-entity-type" value="catalog"/>
					<parameter name="query-set-active-db" value="USE &quot;?&quot;"/>
					<parameter name="supports-references" value="true"/>
					<parameter name="supports-indexes" value="false"/>
					<!-- the meta model by its id: by the driver class it would also take a Generic data source
					     configured by hand with spec 006's drivers.xml, whose tree has no nested schemas -->
					<parameter name="meta-model" value="duckdb_acl_jdbc"/>
				</driver>
			</drivers>
		</datasource>
	</extension>

	<extension point="org.jkiss.dbeaver.generic.meta">
		<meta id="duckdb_acl_jdbc"
		      class="org.jkiss.dbeaver.ext.acl.model.AclMetaModel"
		      dialect="duckdb_acl"/>
	</extension>

	<extension point="org.jkiss.dbeaver.sqlDialect">
		<dialect id="duckdb_acl"
		         parent="generic"
		         class="org.jkiss.dbeaver.ext.acl.model.AclSQLDialect"
		         label="duckdb-acl"
		         description="duckdb SQL and the ACL management grammar"/>
	</extension>
	<!-- spec 007.2: consoles and view-as - each a connection of its own (a temporary copy of the user's); shown only
	     where the connection's platform.console_info() offers it, judged again by the node whatever is shown -->
	<extension point="org.eclipse.core.expressions.propertyTesters">
		<propertyTester id="io.github.hugrlab.acl.consoleTester"
		                class="org.jkiss.dbeaver.ext.acl.ui.AclConsoleTester"
		                namespace="io.github.hugrlab.acl"
		                properties="console"
		                type="org.jkiss.dbeaver.model.navigator.DBNDataSource"/>
	</extension>

	<extension point="org.eclipse.ui.commands">
		<command id="io.github.hugrlab.acl.console" name="duckdb-acl console"
		         description="A management or native console, or the catalog as a role sees it"
		         defaultHandler="org.jkiss.dbeaver.ext.acl.ui.AclConsoleHandler">
			<commandParameter id="io.github.hugrlab.acl.console.kind" name="Kind" optional="false"/>
		</command>
	</extension>

	<extension point="org.eclipse.ui.menus">
		<menuContribution locationURI="popup:org.eclipse.ui.popup.any?after=additions">
			<menu id="io.github.hugrlab.acl.menu" label="duckdb-acl">
				<visibleWhen checkEnabled="false">
					<with variable="selection">
						<count value="1"/>
						<iterate ifEmpty="false">
							<and>
								<instanceof value="org.jkiss.dbeaver.model.navigator.DBNDataSource"/>
								<test property="io.github.hugrlab.acl.console" args="any" forcePluginActivation="true"/>
							</and>
						</iterate>
					</with>
				</visibleWhen>
				<command commandId="io.github.hugrlab.acl.console" label="Management console" tooltip="An SQL console where every statement is management (ACL …)" style="push">
					<parameter name="io.github.hugrlab.acl.console.kind" value="manage"/>
					<visibleWhen checkEnabled="false">
						<with variable="selection">
							<iterate ifEmpty="false" operator="and">
								<and>
									<instanceof value="org.jkiss.dbeaver.model.navigator.DBNDataSource"/>
									<test property="io.github.hugrlab.acl.console" args="manage" forcePluginActivation="true"/>
								</and>
							</iterate>
						</with>
					</visibleWhen>
				</command>
				<command commandId="io.github.hugrlab.acl.console" label="Native console" tooltip="An SQL console of plain SQL outside the virtual catalog (passthrough)" style="push">
					<parameter name="io.github.hugrlab.acl.console.kind" value="native"/>
					<visibleWhen checkEnabled="false">
						<with variable="selection">
							<iterate ifEmpty="false" operator="and">
								<and>
									<instanceof value="org.jkiss.dbeaver.model.navigator.DBNDataSource"/>
									<test property="io.github.hugrlab.acl.console" args="native" forcePluginActivation="true"/>
								</and>
							</iterate>
						</with>
					</visibleWhen>
				</command>
				<command commandId="io.github.hugrlab.acl.console" label="View as role…" tooltip="A read-only connection whose tree is the catalog as a role sees it" style="push">
					<parameter name="io.github.hugrlab.acl.console.kind" value="view_as"/>
					<visibleWhen checkEnabled="false">
						<with variable="selection">
							<iterate ifEmpty="false" operator="and">
								<and>
									<instanceof value="org.jkiss.dbeaver.model.navigator.DBNDataSource"/>
									<test property="io.github.hugrlab.acl.console" args="view_as" forcePluginActivation="true"/>
								</and>
							</iterate>
						</with>
					</visibleWhen>
				</command>
			</menu>
		</menuContribution>
	</extension>
</plugin>
